#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        To1_macro: To1_macro {
            compatible = "zmk,behavior-macro";
            label = "To1_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF &rgb_ug RGB_COLOR_HSB(353,100,50) &to 1>;
        };

        To0_macro: To0_macro {
            compatible = "zmk,behavior-macro";
            label = "To0_macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFR &to 0>;
        };

        To2_macro: To2_macro {
            compatible = "zmk,behavior-macro";
            label = "To2_macro";
            #binding-cells = <0>;
            bindings =
                <&to 2>,
                <&macro_wait_time 30>,
                <&rgb_ug RGB_COLOR_HSB(250,100,50)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp ESC         &kp N1  &kp N2   &kp N3     &kp N4      &kp N5          &kp N6          &kp N7        &kp N8     &kp N9   &kp N0    &kp HASH
&kp TAB         &kp Q   &kp W    &kp E      &kp R       &kp T           &kp Y           &kp U         &kp I      &kp O    &kp P     &kp MINUS
&kp LEFT_SHIFT  &kp A   &lt 4 S  &kp D      &lt 3 F     &kp G           &kp H           &kp J         &kp K      &kp L    &kp SEMI  &kp SQT
&kp PAGE_UP     &kp Z   &kp X    &kp C      &kp V       &lt 2 B         &kp N           &kp M         &kp COMMA  &kp DOT  &kp FSLH  &kp HOME
                                 &kp RCTRL  &kp SPACE   &mo 1           &kp LEFT_SHIFT  &kp LEFT_WIN
                                            &kp RETURN  &kp LEFT_ALT    &kp BACKSPACE
            >;
        };

        F_Mouse_arrows {
            bindings = <
&kp F1               &kp F2     &kp F3     &kp F4     &kp F5              &kp F6             &kp F7              &kp F8     &kp F9     &kp F10           &kp F11               &kp F12
&trans               &trans     &trans     &trans     &trans              &kp LC(LA(TAB))    &kp LC(Y)           &kp LC(U)  &kp UP     &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp EQUAL
&kp LS(LC(LA(F12)))  &kp LC(A)  &kp LC(S)  &kp LC(D)  &kp LC(F)           &kp LC(G)          &mkp LCLK           &kp LEFT   &kp DOWN   &kp RIGHT         &kp EQUAL             &kp HASH
&kp PAGE_DOWN        &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)           &kp LA(LC(B))      &kp LC(LEFT_SHIFT)  &mkp LCLK  &mkp RCLK  &kp RIGHT         &kp NON_US_BACKSLASH  &kp END
                                           &kp RCTRL  &kp LC(LEFT_SHIFT)  &trans             &kp LEFT_SHIFT      &mo 5
                                                      &trans              &trans             &kp DELETE
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans     &trans
                                &trans  &trans    &trans
            >;
        };

        Macro_Media_Layer {
            bindings = <
&kp F13  &kp F14  &kp F15  &kp F16  &kp F17  &kp F18              &kp F19  &kp F20  &kp F21  &kp F22  &kp F23  &kp F12
&trans   &trans   &trans   &trans   &trans   &trans               &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans               &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans               &trans   &trans   &trans   &trans   &trans   &trans
                           &trans   &trans   &trans               &trans   &trans
                                    &trans   &kp LC(BACKSPACE)    &trans
            >;
        };
    };
};
